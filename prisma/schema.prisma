// Schéma de base — à faire évoluer selon les besoins.
// Régénérer le client : npm run db:generate
// Créer/appliquer une migration : npm run db:migrate

// Prisma 7 : le générateur « prisma-client-js » a disparu au profit de
// « prisma-client », dont le chemin de sortie est obligatoire. Le client n'est
// donc plus dans node_modules/@prisma/client mais dans src/generated/prisma,
// versionné par .gitignore et régénéré au démarrage du conteneur.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// L'URL n'a plus sa place ici depuis la v7 (erreur P1012) : Migrate la lit
// dans prisma.config.ts, le client la reçoit via l'adaptateur.
datasource db {
  provider = "postgresql"
}

// Un utilisateur = un compte Bungie authentifié
model User {
  id             String     @id @default(cuid())
  bungieMembershipId String @unique
  displayName    String
  // Tokens OAuth (à chiffrer en production)
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  // Synchronisation des préférences et des groupes avec le compte.
  //
  // Sur le User et non sur UserSettings : le drapeau doit valoir quelque chose
  // avant qu'aucune préférence n'ait été déposée — c'est ce qui permet de
  // l'activer par défaut pour un nouveau compte, là où l'absence de ligne
  // valait auparavant « synchronisation coupée ».
  syncEnabled    Boolean    @default(true)
  settings       UserSettings?
  loadoutGroups  UserLoadoutGroups?
}

// Préférences synchronisées d'un utilisateur.
//
// L'absence de ligne vaut « rien de déposé » : c'est ce que rétablit
// « Supprimer les données de synchronisation ». Elle ne dit plus si la
// synchronisation est active — ce drapeau vit sur `User.syncEnabled`, ce qui
// permet de couper la synchronisation sans effacer ce qui a été déposé : le
// cookie reprend alors la main, et la sauvegarde reste là pour un retour.
model UserSettings {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  // Mêmes clés que l'état persisté dans le cookie (cf. lib/settings/store.ts) :
  // le format suit l'UI, le stocker en JSON évite une migration par réglage.
  data      Json
  updatedAt DateTime @updatedAt
}

// Groupes d'équipements synchronisés d'un utilisateur.
//
// Une ligne par utilisateur et non par groupe : le client tient de toute façon
// la liste entière en mémoire, la dépose d'un bloc et la relit de même — comme
// UserSettings. Une table de groupes et une d'emplacements n'apporteraient
// aucune requête utile et imposeraient une migration à chaque évolution du
// format d'un instantané, qui suit celui de l'API Bungie.
//
// Pas de drapeau ici non plus : la synchronisation des groupes suit celle des
// préférences (`User.syncEnabled`), et couper celle-ci efface la ligne — le
// stockage local garde sa copie (cf. lib/loadouts/groups).
model UserLoadoutGroups {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  // Tableau de LoadoutGroup, même forme que le stockage local
  // (cf. lib/loadouts/groups/types.ts)
  data      Json
  updatedAt DateTime @updatedAt
}
