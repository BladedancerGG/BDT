// Schéma de base — à faire évoluer selon les besoins.
// Régénérer le client : npm run db:generate
// Créer/appliquer une migration : npm run db:migrate

// Prisma 7 : le générateur « prisma-client-js » a disparu au profit de
// « prisma-client », dont le chemin de sortie est obligatoire. Le client n'est
// donc plus dans node_modules/@prisma/client mais dans src/generated/prisma,
// versionné par .gitignore et régénéré au démarrage du conteneur.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// L'URL n'a plus sa place ici depuis la v7 (erreur P1012) : Migrate la lit
// dans prisma.config.ts, le client la reçoit via l'adaptateur.
datasource db {
  provider = "postgresql"
}

// Un utilisateur = un compte Bungie authentifié
model User {
  id             String     @id @default(cuid())
  bungieMembershipId String @unique
  displayName    String
  // Tokens OAuth (à chiffrer en production)
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  // Synchronisation des préférences et des groupes avec le compte.
  //
  // Sur le User et non sur UserSettings : le drapeau doit valoir quelque chose
  // avant qu'aucune préférence n'ait été déposée — c'est ce qui permet de
  // l'activer par défaut pour un nouveau compte, là où l'absence de ligne
  // valait auparavant « synchronisation coupée ».
  syncEnabled    Boolean    @default(true)
  // Accès aux pages d'administration (/admin). Aucune interface ne le pose :
  // il s'accorde à la main, en base (voir le README).
  admin          Boolean    @default(false)
  // Dernière activité, et non dernier passage par OAuth : une session dure
  // trente jours sans jamais y repasser. Mise à jour au plus une fois par heure
  // (cf. lib/auth/current-user.ts). Nulle tant que le compte n'a rien chargé
  // depuis l'ajout de la colonne.
  lastSeenAt     DateTime?
  settings       UserSettings?
  loadoutGroups  UserLoadoutGroups?
  sharedLoadouts SharedLoadout[]
  bungieCalls    BungieApi[]
}

// Préférences synchronisées d'un utilisateur.
//
// L'absence de ligne vaut « rien de déposé » : c'est ce que rétablit
// « Supprimer les données de synchronisation ». Elle ne dit plus si la
// synchronisation est active — ce drapeau vit sur `User.syncEnabled`, ce qui
// permet de couper la synchronisation sans effacer ce qui a été déposé : le
// cookie reprend alors la main, et la sauvegarde reste là pour un retour.
model UserSettings {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  // Mêmes clés que l'état persisté dans le cookie (cf. lib/settings/store.ts) :
  // le format suit l'UI, le stocker en JSON évite une migration par réglage.
  data      Json
  updatedAt DateTime @updatedAt
}

// Groupes d'équipements synchronisés d'un utilisateur.
//
// Une ligne par utilisateur et non par groupe : le client tient de toute façon
// la liste entière en mémoire, la dépose d'un bloc et la relit de même — comme
// UserSettings. Une table de groupes et une d'emplacements n'apporteraient
// aucune requête utile et imposeraient une migration à chaque évolution du
// format d'un instantané, qui suit celui de l'API Bungie.
//
// Pas de drapeau ici non plus : la synchronisation des groupes suit celle des
// préférences (`User.syncEnabled`), et couper celle-ci efface la ligne — le
// stockage local garde sa copie (cf. lib/loadouts/groups).
model UserLoadoutGroups {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  // Tableau de LoadoutGroup, même forme que le stockage local
  // (cf. lib/loadouts/groups/types.ts)
  data      Json
  updatedAt DateTime @updatedAt
}

// Un groupe ou un équipement **partagé** par lien public.
//
// Une table à part, et non un drapeau sur les groupes : ce qui est partagé est
// un INSTANTANÉ figé, autonome, et non une vue du groupe de l'auteur. Un lien
// doit continuer de montrer ce qui a été partagé même si le groupe change
// ensuite, ou disparaît — et surtout, le visiteur n'a pas le profil de
// l'auteur : les objets y sont donc résolus (hash, emplacement, attributs
// enregistrés) plutôt que désignés par instance, seule forme qui ne se relit
// qu'avec le compte d'origine.
model SharedLoadout {
  /**
   * Identifiant ALÉATOIRE et non un cuid croissant : c'est la seule chose qui
   * protège le lien, la page étant publique et sans session.
   */
  id        String   @id
  /** « group » ou « loadout » — voir lib/loadouts/share/types.ts */
  kind      String
  /** Repris tel quel dans l'URL et dans le titre de la page */
  name      String
  /** SharedSnapshot, cf. lib/loadouts/share/types.ts */
  data      Json
  /**
   * L'auteur, pour qu'un compte supprimé emporte ses partages. Le visiteur,
   * lui, n'a aucun compte : la page ne lit jamais cette colonne.
   */
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Journal des appels sortants vers bungie.net, pour les statistiques
// d'administration.
//
// Une ligne par appel LOGIQUE et non par tentative : les nouvelles tentatives
// de `bungieFetch` restent dans la même ligne (`attempts`), sans quoi une
// panne passagère de Bungie gonflerait les compteurs d'autant.
//
// Aucune purge : la rétention est volontairement illimitée. D'où l'index sur la
// date, seul tri que lit la page.
model BungieApi {
  id         String    @id @default(cuid())
  /** GET, POST… */
  method     String
  /**
   * Chemin normalisé, identifiants remplacés par `{id}` et sans paramètres :
   * c'est ce qui permet de regrouper les appels par point d'entrée.
   */
  endpoint   String
  /** pending, running, success, failure — cf. lib/bungie/call-log.ts */
  status     String
  /** Statut HTTP de la dernière réponse, absent sur une panne réseau */
  httpStatus Int?
  /** Code symbolique Bungie d'un refus applicatif, ou message tronqué */
  error      String?
  attempts   Int       @default(0)
  durationMs Int?
  /**
   * Vide pour les appels sans compte (manifeste) ou d'avant la création du
   * compte (premier échange de jetons). SetNull et non Cascade : supprimer un
   * compte ne doit pas réécrire l'historique des appels.
   */
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([createdAt])
  @@index([userId])
}
