{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "outDir": "/tmp/checks",
    "baseUrl": "/app",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "typeRoots": [
      "/app/node_modules/@types"
    ]
  },
  "files": [
    "edit.check.ts",
    "equip.check.ts",
    "insert.check.ts",
    "backup.check.ts",
    "sync-merge.check.ts"
  ]
}