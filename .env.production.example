# Configuration de production.
#   cp .env.production.example .env
#
# Toutes les variables ci-dessous sont OBLIGATOIRES : docker compose refuse de
# démarrer si l'une manque (voir les `:?` dans docker-compose.prod.yml).
# Ce fichier ne doit jamais être versionné.

# --- Domaine ---
# Doit pointer (enregistrement A/AAAA) vers l'IP publique du serveur.
APP_DOMAIN=dlm.exemple.fr
# Adresse de contact pour Let's Encrypt (avis d'expiration)
ACME_EMAIL=admin@exemple.fr

# --- PostgreSQL ---
POSTGRES_USER=dlm
# À générer :  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=dlm

# --- Bungie.net ---
# https://www.bungie.net/en/Application
#   OAuth Client Type : Confidential
#   Redirect URL      : https://<APP_DOMAIN>/api/auth/callback
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# --- Session ---
# À générer :  openssl rand -hex 32
# Changer cette valeur invalide toutes les sessions existantes.
SESSION_SECRET=

# --- Proxy sortant (optionnel) ---
# Voir la section « proxy » du README. Les deux lignes vont ensemble.
#HTTPS_PROXY=http://mon-proxy.exemple:3128
#NODE_OPTIONS=--use-env-proxy
