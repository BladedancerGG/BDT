# Copie ce fichier en ".env" et remplis les valeurs.
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=dlm
POSTGRES_PASSWORD=dlm
POSTGRES_DB=dlm

# URL utilisée par Prisma / l'app.
# En local (hors Docker) l'hôte est "localhost". Dans Docker, Compose fournit
# automatiquement la variante avec "db" comme hôte (voir docker-compose.yml).
DATABASE_URL=postgresql://dlm:dlm@localhost:5432/dlm?schema=public

# --- App ---
# URL publique servie par le proxy Caddy (HTTPS). Sert aux redirections OAuth.
APP_URL=https://localhost

# --- Bungie.net ---
# Crée une app sur https://www.bungie.net/en/Application
# OAuth Client Type : "Confidential"
# Redirect URL : https://localhost/api/auth/callback   (HTTPS obligatoire côté Bungie)
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# --- Session ---
# Secret pour signer les cookies de session. Génère-le avec :
#   openssl rand -hex 32
SESSION_SECRET=
