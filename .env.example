# --- PostgreSQL ---
POSTGRES_USER=bdt
# Generate a DB password with `openssl rand -hex 32` (without characters that could break Prisma), you can leave it as it is for local development
POSTGRES_PASSWORD=bdt
POSTGRES_DB=bdt

# --- Docker ---
# UID/GID the dev container runs as, so that what it writes into the project
# (node_modules, src/generated, package-lock.json) belongs to you.
# Only needed if your host user is not 1000:1000 — check with `id -u` / `id -g`.
DOCKER_UID=1000
DOCKER_GID=1000

# --- App ---
# Public URL, used by Caddy for proxying requests through HTTPS
APP_URL=https://localhost

# --- Bungie.net ---
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# --- Session ---
# Cipher used to generate sessions and cookies, generate one with :
#   openssl rand -hex 32
SESSION_SECRET=
