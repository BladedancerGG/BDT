# Copie ce fichier en ".env" et remplis les valeurs.
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=bdt
# Si tu changes ce mot de passe : pas de caractère spécial. Il est inséré tel
# quel dans DATABASE_URL, et un « / », « + », « @ » ou « : » casse l'analyse de
# l'URL (Prisma : « P1013: invalid port number »). `openssl rand -hex 32` est sûr.
POSTGRES_PASSWORD=bdt
POSTGRES_DB=bdt

# URL utilisée par Prisma / l'app.
# En local (hors Docker) l'hôte est "localhost". Dans Docker, Compose fournit
# automatiquement la variante avec "db" comme hôte (voir docker-compose.yml).
DATABASE_URL=postgresql://bdt:bdt@localhost:5432/bdt?schema=public

# --- App ---
# URL publique servie par le proxy Caddy (HTTPS). Sert aux redirections OAuth.
APP_URL=https://localhost

# --- Bungie.net ---
# Crée une app sur https://www.bungie.net/en/Application
# OAuth Client Type : "Confidential"
# Redirect URL : https://localhost/api/auth/callback   (HTTPS obligatoire côté Bungie)
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# --- Proxy sortant (optionnel) ---
# Utile si la liaison directe vers bungie.net est instable (erreurs 522).
# Les deux lignes vont ensemble : Node ignore HTTP(S)_PROXY tant qu'il n'est
# pas lancé avec --use-env-proxy.
# Ne concerne que les appels faits par le serveur ; le téléchargement des
# tables du manifeste part du navigateur et n'emprunte donc pas ce proxy.
#HTTPS_PROXY=http://mon-proxy.exemple:3128
#HTTP_PROXY=http://mon-proxy.exemple:3128
#NODE_OPTIONS=--use-env-proxy
# Hôtes à joindre en direct, séparés par des virgules
#NO_PROXY=localhost,127.0.0.1,db
#
# Proxy avec authentification : identifiants dans l'URL.
#HTTPS_PROXY=http://utilisateur:motdepasse@mon-proxy.exemple:3128
#
# ATTENTION : tout caractère spécial du mot de passe doit être percent-encodé
# (@ → %40, : → %3A, / → %2F, # → %23, ? → %3F, & → %26, espace → %20).
# Sinon Node REFUSE DE DÉMARRER avec « ERR_INVALID_URL ».
# Pour obtenir la valeur encodée :
#   docker compose exec app node -p "encodeURIComponent('mon:mot@de/passe')"

# --- Session ---
# Secret pour signer les cookies de session. Génère-le avec :
#   openssl rand -hex 32
SESSION_SECRET=
